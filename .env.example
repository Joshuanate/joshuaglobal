# Copy this file to .env.local and fill in your values
# On Vercel: add these in Project Settings → Environment Variables

# Database (use Neon or Supabase for free PostgreSQL)
DATABASE_URL=""

# Auth — generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true
ADMIN_EMAIL="admin@joshuaglobal.live"
ADMIN_PASSWORD=""

# Google OAuth (optional — for user login)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend (for newsletter emails)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="hello@joshuaglobal.live"

# Vercel KV — added automatically when you create a KV store in Vercel
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
KV_REST_API_READ_ONLY_TOKEN=""

# App URL
NEXT_PUBLIC_APP_URL="https://joshuaglobal.live"
NEXT_PUBLIC_APP_NAME="Joshua Global"
